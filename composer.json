{
    "name": "teckfuture/laravel-p6-analyzer",
    "description": "A standalone Laravel package for parsing, analyzing, and exporting Primavera P6 XER schedule files.",
    "type": "library",
    "version": "2.4.0",
    "license": "MIT",
    "minimum-stability": "stable",
    "keywords": ["laravel", "primavera", "p6", "xer", "schedule", "analysis", "dcma", "earned-value", "critical-path"],
    "authors": [
        {
            "name": "TeckFuture"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "orchestra/testbench": "^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "TeckFuture\\P6Analyzer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeckFuture\\P6Analyzer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TeckFuture\\P6Analyzer\\P6AnalyzerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
